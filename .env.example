# --- Django core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,host.docker.internal
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# --- Database ---
# Railway Postgres plugin provides DATABASE_URL automatically.
# DATABASE_URL=postgres://user:pass@host:5432/railway
POSTGRES_DB=mastergo
POSTGRES_USER=mastergo
POSTGRES_PASSWORD=mastergo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (Channels + OTP cache) ---
# Railway Redis plugin provides REDIS_URL automatically.
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=20000
DATABASE_LOCK_TIMEOUT_MS=5000

# Quick local smoke runs without Postgres/Redis:
MASTERGO_USE_SQLITE=0
MASTERGO_SQLITE_PATH=.tmp/backend_dev.sqlite3
MASTERGO_USE_INMEMORY_CHANNELS=0
# `manage.py test` uses in-memory SQLite/Channels automatically. Set this only
# for an explicit PostgreSQL integration run.
MASTERGO_TEST_USE_POSTGRES=0

# --- Urgent order matching ---
# Searching requests expire instead of being offered to a master hours later.
MASTERGO_SEARCH_ORDER_TTL_MINUTES=30
MASTERGO_REALTIME_SEND_TIMEOUT_SECONDS=2
MASTERGO_SLOW_REQUEST_SECONDS=1
MASTERGO_ORDER_SWEEPER_ENABLED=1
MASTERGO_ORDER_SWEEPER_INTERVAL_SECONDS=5
UVICORN_LIMIT_CONCURRENCY=200

# --- SMS OTP (Eskiz.uz) ---
# MASTERGO_MOCK_OTP=1  -> fixed code, no SMS (login with the code below).
# For real SMS: MASTERGO_MOCK_OTP=0, SMS_DRY_RUN=0, fill Eskiz creds.
MASTERGO_MOCK_OTP=1
MASTERGO_MOCK_OTP_CODE=1111
# Keep operator moderation enabled. Set either flag to 1 only in an isolated
# demo environment.
MASTERGO_AUTO_APPROVE_MASTERS=0
MASTERGO_FREE_PACKAGES=0
SMS_DRY_RUN=1
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SENDER=4546
OTP_SMS_TEMPLATE=Opus: tasdiqlash kodi {code}. Hech kimga bermang.

# --- Maps ---
MAPBOX_ACCESS_TOKEN=

# --- Push notifications (Firebase Cloud Messaging) ---
# Deploy (Railway): paste the whole service-account JSON as one line here.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"opus-go-46c24",...}
# Local dev: point to a gitignored file instead (keep it out of git):
FIREBASE_CREDENTIALS_FILE=.secrets/firebase-admin.json
